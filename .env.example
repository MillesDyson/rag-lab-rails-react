# ---- OpenAI (whisper, embeddings, visao) ----
OPENAI_API_KEY=sk-...

# ---- LlamaParse (csv/docx/pdf/xlsx) ----
# pegue em https://cloud.llamaindex.ai -> API Keys
LLAMA_CLOUD_API_KEY=llx-...

# ---- Pinecone Local ----
# o emulador aceita qualquer chave, "pclocal" e a convencao
PINECONE_API_KEY=pclocal
PINECONE_INDEX=raglab

# Valores abaixo valem para rodar FORA do container; dentro do compose eles sao
# sobrescritos pelos nomes dos servicos (http://pinecone:5080, http://api:3000...).
PINECONE_HOST=http://localhost:5080
INGEST_SERVICE_URL=http://localhost:8000
RAILS_CALLBACK_URL=http://localhost:3000

# ---- integracao entre os servicos ----
INTERNAL_TOKEN=dev-token-trocar-depois

# ---- docker ----
# uid/gid do seu usuario, para os arquivos gerados dentro do container
# nao virarem propriedade do root no bind mount
UID=1000
GID=1000
